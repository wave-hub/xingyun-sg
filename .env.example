# ===========================================
# 星運堂 XingYun Tang - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# ===========================================
# Site Configuration
# ===========================================
NEXT_PUBLIC_SITE_URL=https://xingyuntang.sg
NEXT_PUBLIC_SITE_NAME="星運堂 XingYun Tang"

# ===========================================
# Stripe Configuration (Singapore)
# ===========================================
# Get these from https://dashboard.stripe.com/apikeys

# Stripe Secret Key (Server-side only)
STRIPE_SECRET_KEY=sk_test_xxxxx

# Stripe Publishable Key (Client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Webhook Secret (from Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ===========================================
# Stripe Price IDs (Singapore SGD)
# ===========================================
# Create products in Stripe Dashboard and add their Price IDs here
# Dashboard: https://dashboard.stripe.com/products

STRIPE_PRICE_ZIWEI=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_BAZI=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_DALIUREN=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_COMBINED=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_FOLLOWUP=price_xxxxxxxxxxxxxxxxxxxx

# ===========================================
# AI Service (Optional)
# ===========================================
# For AI-powered fortune interpretation
# Get from https://openai.com/api
OPENAI_API_KEY=sk-xxxxx

# ===========================================
# Email Service (Optional)
# ===========================================
# For sending booking confirmations
# Using Resend: https://resend.com
RESEND_API_KEY=re_xxxxx

# ===========================================
# WhatsApp Business (Optional)
# ===========================================
# For staff notifications
# Using Twilio: https://www.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=+14155238886

# ===========================================
# Database (Optional)
# ===========================================
# For storing bookings and customer data
# Using Prisma with PostgreSQL/Supabase
DATABASE_URL=postgresql://user:password@host:5432/xingyuntang

# ===========================================
# Development vs Production
# ===========================================
# NODE_ENV=development
NODE_ENV=production
